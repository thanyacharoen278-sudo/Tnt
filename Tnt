            end
        end
    end, 2)
    makeToggle("Bring Fruit", false, function(v) _G.BringFruit = v end, 3)
    makeButton("TP Nearest Fruit", function()
        local hrp = getHRP()
        if not hrp then return end
        local near, dist = nil, math.huge
        for _, o in pairs(workspace:GetChildren()) do
            if o:IsA("Tool") and o:FindFirstChild("Handle") then
                if string.find(string.lower(o.Name), "fruit") then
                    local d = (hrp.Position - o.Handle.Position).Magnitude
                    if d < dist then near = o.Handle dist = d end
                end
            end
        end
        if near then TP(near.CFrame + Vector3.new(0, 3, 0)) end
    end, 4)
end

