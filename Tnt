local function ClickScreen()
    pcall(function()
        if AttackController and AttackController.activeController then
            local c = AttackController.activeController
            c.timeToNextAttack = 0
            c.attacking = false
            c.blocking = false
            c.hitboxMagnitude = 150
            c.increment = 4
            if c.focusStart then c.focusStart = 0 end
        end
    end)
    pcall(function()
        VU:CaptureController()
        VU:Button1Down(Vector2.new(0, 0))
    end)
    task.wait(0.02)
    pcall(function()
        VU:Button1Up(Vector2.new(0, 0))
    end)
    pcall(function()
        local cam = workspace.CurrentCamera
        local vx = 400
        local vy = 300
        if cam then
            vx = cam.ViewportSize.X / 2
            vy = cam.ViewportSize.Y / 2
        end
        VIM:SendMouseButtonEvent(vx, vy, 0, true, game, 1)
        task.wait(0.015)
        VIM:SendMouseButtonEvent(vx, vy, 0, false, game, 1)
    end)
    pcall(function()
        local char = getChar()
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end
    end)
end

local function GetNearestEnemy(range)
    local hrp = getHRP()
    if not hrp then return nil end
    local nearest = nil
    local best = range or 3000
    local function scan(folder)
        if not folder then return end
        for _, m in pairs(folder:GetChildren()) do
            local mh = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if mh and hum and hum.Health > 0 then
                if not Players:GetPlayerFromCharacter(m) then
                    local d = (hrp.Position - mh.Position).Magnitude
                    if d < best then
                        nearest = m
                        best = d
                    end
                end
            end
        end
    end
    scan(workspace:FindFirstChild("Enemies"))
    scan(workspace:FindFirstChild("Characters"))
    return nearest
end

-- หาเกาะใน Raid ที่มีมอน
local function GetRaidIslandWithEnemy()
    local hrp = getHRP()
    if not hrp then return nil end
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local bestPart = nil
    local bestDist = math.huge

    -- สแกนมอนทุกตัว แล้วเอาตำแหน่งมอนที่ไกลจากเรา (เกาะถัดไป)
    for _, m in pairs(enemies:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if mh and hum and hum.Health > 0 then
            if not Players:GetPlayerFromCharacter(m) then
                local d = (hrp.Position - mh.Position).Magnitude
                if d > 40 and d < bestDist then
                    bestDist = d
                    bestPart = mh
                end
            end
        end
    end

    -- ถ้าไม่มีมอนไกล เอามอนใกล้สุดก็ได้
    if not bestPart then
        local near = GetNearestEnemy(5000)
        if near then
            bestPart = near:FindFirstChild("HumanoidRootPart") or near:FindFirstChild("UpperTorso")
        end
    end

    -- ลองหาจาก Map
    if not bestPart then
        local map = workspace:FindFirstChild("Map")
        if map then
            for _, isl in pairs(map:GetChildren()) do
                local part = isl:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local d = (hrp.Position - part.Position).Magnitude
                    if d > 80 and d < bestDist then
                        -- มีมอนใกล้ part นี้ไหม
                        local has = false
                        for _, m in pairs(enemies:GetChildren()) do
                            local mh = m:FindFirstChild("HumanoidRootPart")
                            if mh and (mh.Position - part.Position).Magnitude < 250 then
                                has = true
                                break
                            end
                        end
                        if has then
                            bestDist = d
                            bestPart = part
                        end
                    end
                end
            end
        end
    end

    return bestPart
end

