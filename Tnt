-- Auto Raid (คลิกเอง + บินไปเกาะ/มอน)
spawn(function()
    while true do
        task.wait(0.12)
        if _G.AutoRaid then
            pcall(function()
                EquipWeapon()
                local hrp = getHRP()
                if not hrp then return end

                -- 1) มอนใกล้ (อยู่เกาะนี้) → ลอยเหนือหัวตี
                local near = GetNearestEnemy(80)
                if near then
                    local eh = near:FindFirstChild("HumanoidRootPart") or near:FindFirstChild("UpperTorso")
                    if eh then
                        hrp.CFrame = CFrame.new(eh.Position + Vector3.new(0, 12, 0), eh.Position)
                        return
                    end
                end

                -- 2) ไม่มีมอนใกล้ → บินไปหาเกาะ/มอนถัดไป
                local target = GetRaidIslandWithEnemy()
                if target then
                    -- บินทีละขั้น (ไม่วาร์ปกระชากเกินไป)
                    local pos = target.Position + Vector3.new(0, 15, 0)
                    local cur = hrp.Position
                    local dist = (pos - cur).Magnitude
                    if dist > 15 then
                        local step = math.min(dist, 60)
                        local dir = (pos - cur).Unit
                        hrp.CFrame = CFrame.new(cur + dir * step, pos)
                    else
                        hrp.CFrame = CFrame.new(pos, target.Position)
                    end
                end
            end)
        end
    end
end)

