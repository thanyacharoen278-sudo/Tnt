-- Auto Raid
spawn(function()
    while true do
        task.wait(0.12)
        if _G.AutoRaid then
            pcall(function()
                EquipWeapon()
                StopShake()
                local hrp = getHRP()
                if not hrp then return end
                local near = GetNearestEnemy(100)
                if near then
                    local eh = near:FindFirstChild("HumanoidRootPart") or near:FindFirstChild("UpperTorso")
                    if eh then
                        hrp.CFrame = CFrame.new(eh.Position + Vector3.new(0, 12, 0), eh.Position)
                        if _G.BringMob then
                            BringMobs(eh.Position, nil)
                        end
                        return
                    end
                end
                -- บินไปมอนถัดไป
                local target = GetNearestEnemy(5000)
                if target then
                    local eh = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("UpperTorso")
                    if eh then
                        local pos = eh.Position + Vector3.new(0, 15, 0)
                        local cur = hrp.Position
                        local dist = (pos - cur).Magnitude
                        if dist > 20 then
                            local step = math.min(dist, 80)
                            hrp.CFrame = CFrame.new(cur + (pos - cur).Unit * step, pos)
                        else
                            hrp.CFrame = CFrame.new(pos, eh.Position)
                        end
                    end
                end
            end)
        end
    end
end)

-- Auto Quest
spawn(function()
    while true do
        task.wait(3)
        if _G.AutoQuest or _G.AutoFarm then
            pcall(function()
                local q = GetCurrentQuest()
                if not q then return end
                local hrp = getHRP()
                if not hrp then return end
                local questName = string.lower(q.quest)

                -- หา NPC ตามชื่อเควส
                local function tryNPC(folder)
                    if not folder then return false end
                    for _, npc in pairs(folder:GetChildren()) do
                        local n = string.lower(npc.Name)
                        if string.find(n, questName) or string.find(questName, n) then
                            local part = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc:FindFirstChildWhichIsA("BasePart")
                            if part then
                                -- ถ้าไกล วาร์ปไปใกล้
                                if (hrp.Position - part.Position).Magnitude > 30 then
                                    hrp.CFrame = part.CFrame + Vector3.new(0, 3, 5)
                                    task.wait(0.5)
                                end
                                local cd = npc:FindFirstChildOfClass("ClickDetector") or (part and part:FindFirstChildOfClass("ClickDetector"))
                                if cd then pcall(function() fireclickdetector(cd) end) end
                                local pp = npc:FindFirstChildOfClass("ProximityPrompt")
                                if pp then pcall(function() fireproximityprompt(pp) end) end
                                return true
                            end
                        end
                    end
                    return false
                end

                tryNPC(workspace:FindFirstChild("NPCs"))
                -- สแกนชื่อ quest ใน workspace
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("ClickDetector") or obj:IsA("ProximityPrompt") then
                        local p = obj.Parent
                        if p then
                            local pn = string.lower(p.Name)
                            if string.find(pn, "quest") or string.find(pn, string.lower(q.quest:sub(1, 8))) then
                                local part = p:IsA("BasePart") and p or p:FindFirstChildWhichIsA("BasePart")
                                if part and (hrp.Position - part.Position).Magnitude < 40 then
                                    if obj:IsA("ClickDetector") then
                                        pcall(function() fireclickdetector(obj) end)
                                    else
                                        pcall(function() fireproximityprompt(obj) end)
                                    end
                                end
                            end
                        end
                    end
                end

                -- กด Accept ใน GUI
                local pg = LP:FindFirstChild("PlayerGui")
                if pg then
                    for _, gui in pairs(pg:GetDescendants()) do
                        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                            local t = string.lower(tostring(gui.Text or gui.Name or ""))
                            if string.find(t, "accept") or string.find(t, "confirm") or string.find(t, "quest") then
                                if gui.Visible then
                                    pcall(function() firesignal(gui.MouseButton1Click) end)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

