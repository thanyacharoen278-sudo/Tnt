local function EquipWeapon()
    pcall(function()
        local char = getChar()
        if not char then return end
        for _, t in pairs(char:GetChildren()) do
            if t:IsA("Tool") then return end
        end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        for _, tool in pairs(bag:GetChildren()) do
            if tool:IsA("Tool") then
                local hum = getHum()
                if hum then hum:EquipTool(tool) end
                return
            end
        end
    end)
end

local AttackController = nil
local function findController()
    pcall(function()
        local ok, cf = pcall(function()
            return require(LP.PlayerScripts:WaitForChild("CombatFramework", 2))
        end)
        if ok and cf then AttackController = cf end
    end)
    pcall(function()
        if typeof(getgc) == "function" then
            for _, v in pairs(getgc(true)) do
                if type(v) == "table" and rawget(v, "activeController") then
                    AttackController = v
                    break
                end
            end
        end
    end)
end
findController()

