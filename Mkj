local function StopShake()
    pcall(function()
        local util = ReplicatedStorage:FindFirstChild("Util")
        if util then
            local Cam = require(util:WaitForChild("CameraShaker", 1))
            if Cam then
                if Cam.Stop then Cam:Stop() end
                if Cam.CameraShakeInstance then
                    Cam.CameraShakeInstance.CameraShakeState = {
                        FadingIn = 3, FadingOut = 2, Sustained = 0, Inactive = 1
                    }
                end
            end
        end
    end)
    pcall(function()
        local cf = LP.PlayerScripts:FindFirstChild("CombatFramework")
        if cf then
            local Cam = require(cf:WaitForChild("CameraShaker", 1))
            if Cam and Cam.CameraShakeInstance then
                Cam.CameraShakeInstance.CameraShakeState = {
                    FadingIn = 3, FadingOut = 2, Sustained = 0, Inactive = 1
                }
            end
        end
    end)
end
StopShake()

local function ClickScreen()
    pcall(function()
        if AttackController and AttackController.activeController then
            local c = AttackController.activeController
            c.timeToNextAttack = 0
            c.attacking = false
            c.blocking = false
            c.hitboxMagnitude = _G.HitboxSize or 80
            c.increment = 4
            if c.focusStart then c.focusStart = 0 end
        end
    end)
    pcall(function()
        VU:CaptureController()
        VU:Button1Down(Vector2.new(0, 0))
    end)
    task.wait(0.02)
    pcall(function()
        VU:Button1Up(Vector2.new(0, 0))
    end)
    pcall(function()
        local cam = workspace.CurrentCamera
        local vx, vy = 400, 300
        if cam then
            vx = cam.ViewportSize.X / 2
            vy = cam.ViewportSize.Y / 2
        end
        VIM:SendMouseButtonEvent(vx, vy, 0, true, game, 1)
        task.wait(0.015)
        VIM:SendMouseButtonEvent(vx, vy, 0, false, game, 1)
    end)
    pcall(function()
        local char = getChar()
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end
    end)
end

local function GetEnemyByName(name, range)
    local hrp = getHRP()
    if not hrp then return nil end
    local nearest, best = nil, range or 5000
    local function scan(folder)
        if not folder then return end
        for _, m in pairs(folder:GetChildren()) do
            local mh = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
                local match = true
                if name and name \~= "" then
                    match = string.find(string.lower(m.Name), string.lower(name)) \~= nil
                end
                if match then
                    local d = (hrp.Position - mh.Position).Magnitude
                    if d < best then
                        nearest = m
                        best = d
                    end
                end
            end
        end
    end
    scan(workspace:FindFirstChild("Enemies"))
    scan(workspace:FindFirstChild("Characters"))
    return nearest
end

local function GetNearestEnemy(range)
    return GetEnemyByName(nil, range)
end

-- รวบมอน
local function BringMobs(centerPos, enemyName)
    pcall(function()
        local enemies = workspace:FindFirstChild("Enemies")
        if not enemies then return end
        for _, m in pairs(enemies:GetChildren()) do
            local mh = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
                local ok = true
                if enemyName and enemyName \~= "" then
                    ok = string.find(string.lower(m.Name), string.lower(enemyName)) \~= nil
                end
                if ok then
                    local d = (mh.Position - centerPos).Magnitude
                    if d < 300 and d > 5 then
                        mh.CFrame = CFrame.new(centerPos + Vector3.new(math.random(-4, 4), 0, math.random(-4, 4)))
                        mh.CanCollide = false
                        mh.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        end
    end)
end

